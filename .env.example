# ============================================================================
# Droply configuration template
#
# Copy this to `.env` for your own reference. Nothing here is read at build time:
# the frontend is configured through <meta> tags in index.html (see
# js/config.js), and the signaling Worker through worker/wrangler.toml.
# Never commit real credentials.
# ============================================================================

# --- Frontend (index.html meta tags) ----------------------------------------

# Base URL of the deployed signaling Worker.
#   Empty  -> same origin, i.e. /api/* is reverse-proxied to the Worker.
#   Local  -> http://127.0.0.1:8787 (applied automatically on localhost)
DROPLY_SIGNALING_URL=""

# --- Optional TURN relay (needed on symmetric NAT / strict firewalls) -------

# Comma-separated list, e.g. turn:turn.example.com:3478?transport=udp
DROPLY_TURN_URL=""
DROPLY_TURN_USERNAME=""
DROPLY_TURN_CREDENTIAL=""

# --- Signaling Worker (worker/wrangler.toml [vars]) -------------------------

# Comma-separated browser origins allowed to call the API. Required in
# production; "*" is for local development only.
# Production (the canonical host):
ALLOWED_ORIGINS="https://droply-files.vercel.app"
# Local development:
# ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Waiting-room lifetime in seconds (clamped to 120..3600 by the Worker).
ROOM_TTL_SECONDS="600"

# --- Cloudflare deploy credentials (optional, not needed for wrangler login) -
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""
