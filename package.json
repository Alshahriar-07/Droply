{
  "name": "droply",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based, one-time peer-to-peer file transfer. Static frontend + Cloudflare signaling Worker.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "serve": "npx --yes serve@14 . -l 4173",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
